  {
    "id": "m1_display_logic",
    "type": "function",
    "z": "tab_matrix1",
    "name": "Anzeige-Logik (PV default)",
    "func": "var watts = flow.get('m1_pv_watts') || 0;\nvar dailyKwh = flow.get('m1_daily_kwh') || 0;\nvar yesterdayKwh = flow.get('m1_yesterday_kwh') || 0;\nvar flashUntil = flow.get('m1_show_time_until') || 0;\nvar now = Date.now();\n\n// Uhrzeit-Phase (10s von 60s Zyklus)\nif (now < flashUntil) {\n    var d = new Date();\n    var h = String(d.getHours()).padStart(2, '0');\n    var m = String(d.getMinutes()).padStart(2, '0');\n    var sep = (d.getSeconds() % 2 === 0) ? ':' : ' ';\n    msg.payload = h + sep + m;\n    return msg;\n}\n\n// Standard: PV-Daten\nif (watts >= 15) {\n    msg.payload = Math.round(watts) + 'W';\n} else {\n    var kwh;\n    if (dailyKwh < 0.05 && yesterdayKwh > 0.05) {\n        kwh = yesterdayKwh;\n    } else {\n        kwh = dailyKwh;\n    }\n    msg.payload = kwh.toFixed(1) + 'kW';\n}\nreturn msg;",
    "outputs": 1,
    "timeout": "",
    "noerr": 0,
    "initialize": "flow.set('m1_pv_watts', 0);\nflow.set('m1_daily_kwh', 0);\nflow.set('m1_yesterday_kwh', 0);\nflow.set('m1_show_time_until', 0);",
    "finalize": "",
    "libs": [],
    "x": 370,
    "y": 440,
    "wires": [
      [
        "m1_passthrough"
      ]
    ]
  },

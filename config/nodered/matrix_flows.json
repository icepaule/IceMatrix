    "id": "lm2_format_time",
    "type": "function",
    "z": "tab_led_matrix2",
    "name": "Format HH:MM",
    "func": "// Aktuelle Uhrzeit als HH:MM formatieren\nvar now = new Date();\nvar h = String(now.getHours()).padStart(2, '0');\nvar m = String(now.getMinutes()).padStart(2, '0');\nmsg.payload = h + ':' + m;\nreturn msg;",
    "outputs": 1,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",

  {
    "id": "m2_display_logic",
    "type": "function",
    "z": "tab_matrix2",
    "name": "Anzeige-Logik",
    "func": "var watts = flow.get('m2_pv_watts') || 0;\nvar dailyKwh = flow.get('m2_daily_kwh') || 0;\nvar yesterdayKwh = flow.get('m2_yesterday_kwh') || 0;\nvar flashUntil = flow.get('m2_show_pv_until') || 0;\nvar now = Date.now();\n\n// PV-Daten Phase (10s von 60s Zyklus)\nif (now < flashUntil) {\n    if (watts >= 15) {\n        // Aktuelle Leistung in W\n        msg.payload = Math.round(watts) + 'W';\n    } else {\n        // Tagessumme oder Vortag in kWh\n        var kwh;\n        if (dailyKwh < 0.05 && yesterdayKwh > 0.05) {\n            kwh = yesterdayKwh;\n        } else {\n            kwh = dailyKwh;\n        }\n        // toFixed(1) mit Punkt - MAX7219 zeigt Punkt kompakt an\n        msg.payload = kwh.toFixed(1) + 'kW';\n    }\n    return msg;\n}\n\n// Standard: Uhrzeit mit blinkendem Doppelpunkt\nvar d = new Date();\nvar h = String(d.getHours()).padStart(2, '0');\nvar m = String(d.getMinutes()).padStart(2, '0');\nvar sep = (d.getSeconds() % 2 === 0) ? ':' : ' ';\nmsg.payload = h + sep + m;\nreturn msg;",
    "outputs": 1,
    "timeout": "",
    "noerr": 0,
    "initialize": "flow.set('m2_pv_watts', 0);\nflow.set('m2_daily_kwh', 0);\nflow.set('m2_yesterday_kwh', 0);\nflow.set('m2_show_pv_until', 0);",
    "finalize": "",
    "libs": [],
    "x": 350,
    "y": 440,
    "wires": [
      [
        "m2_dedup"
      ]
    ]
  },

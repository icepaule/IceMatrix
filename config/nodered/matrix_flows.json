  {
    "id": "m2_inject",
    "type": "inject",
    "z": "tab_matrix2",
    "name": "Jede Sekunde",
    "props": [
      {
        "p": "payload"
      }
    ],
    "repeat": "1",
    "crontab": "",
    "once": true,

    "id": "m3_inject_alerts",
    "type": "inject",
    "z": "tab_matrix3",
    "name": "Alle 5 Sekunden",
    "props": [
      {
        "p": "payload"
      }
    ],
    "repeat": "5",
    "crontab": "",
    "once": true,
    "onceDelay": "10",
    "topic": "",

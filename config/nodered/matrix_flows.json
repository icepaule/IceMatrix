  {
    "id": "m3_display_logic",
    "type": "function",
    "z": "tab_matrix3",
    "name": "Links: Uhr/PV | Rechts: Alerts",
    "func": "var watts = flow.get('m3_pv_watts') || 0;\nvar dailyKwh = flow.get('m3_daily_kwh') || 0;\nvar yesterdayKwh = flow.get('m3_yesterday_kwh') || 0;\nvar flashUntil = flow.get('m3_show_pv_until') || 0;\nvar now = Date.now();\nvar left = '';\n\n// === LINKE HAELFTE: Uhr / PV (max 5 Zeichen) ===\nif (now < flashUntil) {\n    if (watts >= 15) {\n        left = Math.round(watts) + 'W';\n    } else {\n        var kwh = (dailyKwh < 0.05 && yesterdayKwh > 0.05) ? yesterdayKwh : dailyKwh;\n        left = kwh.toFixed(1) + 'kW';\n    }\n} else {\n    var d = new Date();\n    var h = String(d.getHours()).padStart(2, '0');\n    var m = String(d.getMinutes()).padStart(2, '0');\n    var sep = (d.getSeconds() % 2 === 0) ? ':' : ' ';\n    left = h + sep + m;\n}\n\n// Links auf 5 Zeichen padden\nwhile (left.length < 5) left = left + ' ';\n\n// === RECHTE HAELFTE: Benachrichtigungen (max 4 Zeichen) ===\nvar alerts = flow.get('m3_alerts') || [];\nvar right = '';\nif (alerts.length > 0) {\n    var idx = Math.floor(Date.now() / 3000) % alerts.length;\n    right = alerts[idx].substring(0, 4);\n}\n\n// Kombinieren: links(5) + Leerzeichen + rechts(max 4) = max 10 Zeichen\nif (right) {\n    msg.payload = left + ' ' + right;\n} else {\n    msg.payload = left;\n}\nreturn msg;",
    "outputs": 1,
    "timeout": "",
    "noerr": 0,
    "initialize": "flow.set('m3_pv_watts', 0);\nflow.set('m3_daily_kwh', 0);\nflow.set('m3_yesterday_kwh', 0);\nflow.set('m3_show_pv_until', 0);\nflow.set('m3_alerts', []);",
    "finalize": "",
    "libs": [],
    "x": 410,
    "y": 520,
    "wires": [
      [
        "m3_mqtt_display",
        "m3_debug"
      ]
    ]
  },

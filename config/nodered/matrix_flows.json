  {
    "id": "lm2_format_pv",
    "type": "function",
    "z": "tab_led_matrix2",
    "name": "Format PV Watt",
    "func": "// PV-Leistung formatieren\nvar watts = parseFloat(msg.payload) || 0;\n\nif (watts >= 1000) {\n    // Ab 1kW: '1.2kW' Format\n    msg.payload = (watts / 1000).toFixed(1) + 'kW';\n} else {\n    // Unter 1kW: '420W' Format\n    msg.payload = Math.round(watts) + 'W';\n}\n\nreturn msg;",
    "outputs": 1,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",

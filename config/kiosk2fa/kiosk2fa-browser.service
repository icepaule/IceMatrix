[Unit]
Description=Kiosk2FA Anzeige (cage + Chromium, Vollbild, kein Screensaver)
After=kiosk2fa-server.service systemd-user-sessions.service getty@tty1.service plymouth-quit.service network-online.target
Wants=kiosk2fa-server.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=kiosk
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
# --no-memcheck: der /usr/bin/chromium-Wrapper zeigt bei <1GB RAM (Pi Zero 2W:
# 512MB) sonst einen zenoty-Bestaetigungsdialog ("Launch anyway"), der ohne
# Maus/Tastatur am Kiosk nie wegklickbar waere - Boot haette sonst dort haengen
# bleiben koennen. --kiosk = Vollbild ohne Fensterrahmen, --noerrdialogs/
# --disable-infobars unterdruecken Crash-/Update-Popups, check-for-update-
# interval verhindert Reload durch Chromium-Eigenupdate-Check. cage selbst hat
# keinerlei Idle-/DPMS-Logik - daher automatisch "kein Screensaver/Dunkelschaltung".
# --disable-gpu: GPU-Rasterization ueber den VC4/V3D-Treiber unter Wayland/Ozone
# lieferte nur einen weissen Bildschirm (per grim-Screenshot verifiziert, Renderer-
# Prozess lief, aber kein Bildinhalt). Seite ist reines CSS/Text ohne WebGL/Video -
# Software-Rendering ist hier voellig ausreichend und deutlich robuster.
ExecStart=/usr/bin/cage -- /usr/bin/chromium \
    --no-memcheck \
    --disable-gpu \
    --ozone-platform=wayland \
    --enable-features=UseOzonePlatform \
    --kiosk \
    --noerrdialogs \
    --disable-infobars \
    --disable-session-crashed-bubble \
    --disable-translate \
    --disable-features=Translate,TranslateUI \
    --no-first-run \
    --lang=de \
    --check-for-update-interval=31536000 \
    --overscroll-history-navigation=0 \
    http://127.0.0.1:5000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

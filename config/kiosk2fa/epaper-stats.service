[Unit]
Description=Kiosk2FA e-Paper Betriebsdaten (Waveshare 2.13" HAT)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/home/mpauli/kiosk2fa
ExecStart=/usr/bin/python3 /home/mpauli/kiosk2fa/epaper_stats.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target

[Unit]
Description=Kiosk2FA Erstboot-Provisioning (Pakete, kiosk-User, Services aktivieren)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/kiosk2fa-firstboot-provision.sh
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal
# Skript ist idempotent (Marker-Datei-Guard) - bei Fehlschlag (kein Netz/NTP
# noch nicht da/apt-Fehler) alle 2min neu versuchen statt fuer immer failed
# stehenzubleiben.
Restart=on-failure
RestartSec=120

[Install]
WantedBy=multi-user.target

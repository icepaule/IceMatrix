[Unit]
Description=Kiosk2FA Backend (Flask, liefert TOTP-Codes lokal an den Kiosk-Browser)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/home/mpauli/kiosk2fa
ExecStart=/usr/bin/python3 /home/mpauli/kiosk2fa/server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

# Kopie dieser Datei zu secrets_matrix5.py machen und mit echten Accounts befuellen.
# NIEMALS committen (siehe .gitignore) - liegt nur lokal auf dem Pi.
#
# Name -> Base32-Secret. Reihenfolge/Auswahl der Anzeige kommt separat per MQTT (aus HA).
#
# Base32-Secret kommt aus dem urspruenglichen 2FA-Setup-QR-Code (z.B. beim
# Einrichten des jeweiligen Dienstes selbst nochmal als TOTP-Secret anzeigen lassen,
# oder aus einem Google-Authenticator-"Konto uebertragen"-Export dekodiert - dieser
# QR-Export enthaelt ALLE Accounts auf einmal, also mit Vorsicht behandeln).
#
# JBSWY3DPEHPK3PXP ist der oeffentliche RFC-6238-Testvektor, kein echtes Secret.
ACCOUNTS = {
    "Beispiel1": "JBSWY3DPEHPK3PXP",
    "Beispiel2": "JBSWY3DPEHPK3PXP",
    "Beispiel3": "JBSWY3DPEHPK3PXP",
}
